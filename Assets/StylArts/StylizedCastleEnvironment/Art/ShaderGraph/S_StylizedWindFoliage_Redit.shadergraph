{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "63e5744102ca44c58038ed97d99d7d67",
    "m_Title": "Vertex Position Input",
    "m_Content": "Vertex Position by default is the object position, we multiply our wind with the new mesh cards to apply wind effect and then add the new effect into the object position. \n\nPS: Inputting effects into the vertex position without adding it to the default object position or without converting into object position, breaks the original position and make the renderer appear a certain distance away from the mesh.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -387.0,
        "y": -152.0,
        "width": 241.0,
        "height": 263.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

